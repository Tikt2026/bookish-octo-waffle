<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Tickets Brasil - Copa 2026</title>
</head>
<body class="bg-gray-50">

    <nav class="bg-white shadow-md p-4 flex justify-between items-center sticky top-0 z-50">
        <div class="text-2xl font-bold text-blue-600">TICKETS<span class="text-yellow-500">BR</span></div>
        <div class="hidden md:block w-1/3">
            <input type="text" placeholder="Buscar por jogo, cidade ou estádio..." class="w-full border rounded-full py-2 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="space-x-4">
            <button class="text-gray-600 font-medium">Suporte</button>
            <button class="bg-blue-600 text-white px-6 py-2 rounded-full font-bold hover:bg-blue-700">Entrar</button>
        </div>
    </nav>

    <header class="bg-blue-900 text-white py-12 px-6 text-center">
        <h1 class="text-4xl font-extrabold mb-4">Ingressos Copa do Mundo FIFA 2026™</h1>
        <p class="text-lg opacity-90">Garanta seu lugar no maior espetáculo da Terra.</p>
    </header>

    <main class="max-w-6xl mx-auto p-6">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Próximos Jogos</h2>
            <select class="border rounded-lg p-2 bg-white">
                <option>Filtrar por Data</option>
                <option>Filtrar por Sede</option>
            </select>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <div class="bg-white rounded-xl shadow-sm border overflow-hidden hover:shadow-lg transition">
                <div class="p-5">
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-xs font-bold uppercase bg-gray-100 px-2 py-1 rounded text-gray-500">Grupo A</span>
                        <span class="text-xs text-red-500 font-bold">● Esgotando rápido</span>
                    </div>
                    <div class="flex items-center justify-around mb-6">
                        <div class="text-center font-bold">BRASIL</div>
                        <div class="text-xl font-light text-gray-400 font-serif">VS</div>
                        <div class="text-center font-bold">FRANÇA</div>
                    </div>
                    <div class="text-sm text-gray-600 mb-1">📅 12 de Junho, 2026</div>
                    <div class="text-sm text-gray-600 mb-4 font-medium">📍 MetLife Stadium, NY</div>
                    <div class="border-t pt-4 flex justify-between items-center">
                        <div>
                            <p class="text-xs text-gray-400 uppercase">A partir de</p>
                            <p class="text-xl font-bold text-green-600">R$ 1.250</p>
                        </div>
                        <button class="bg-blue-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-blue-700 transition">Ver Ingressos</button>
                    </div>
                </div>
            </div>

            </div>
    </main>

    <footer class="bg-gray-100 mt-20 py-10 border-t">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <p class="text-gray-500 text-sm">© 2026 Tickets Brasil Intermediações. Todos os direitos reservados.</p>
            <div class="flex justify-center space-x-6 mt-4">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a2/Logo_Pix.png" alt="Pix" class="h-6 grayscale opacity-50">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" class="h-4 grayscale opacity-50">
            </div>
        </div>
    </footer>

</body>
</html>
